---
import { Image } from 'astro:assets';
import { brand, heroPanels } from '../data/media';
import { site, whatsappLink } from '../data/site';

/* Figures that are true and checkable from the client's document, so nothing
   here needs a disclaimer: four professionals, eight sessions, ten services. */
const stats = [
  { value: 4, suffix: '', label: 'Profesionales' },
  { value: 8, suffix: '', label: 'Sesiones al mes' },
  { value: 10, suffix: '', label: 'Servicios' },
];
---

<section data-hero class="relative isolate grain flex min-h-[100svh] flex-col overflow-hidden">
  <!-- Video layer: a strip of vertical panels. One column on phones, two from
       md, three from lg — see the note in data/media.ts for why this beats one
       wide clip. Each panel keeps its own 9:16 frame under object-cover, so the
       crop is slight at every breakpoint. -->
  <div
    data-hero-media
    class="absolute inset-0 -z-20 grid grid-cols-1 will-change-transform md:grid-cols-2 lg:grid-cols-3"
  >
    {
      heroPanels.map((panel) => (
        <video
          data-hero-video
          data-src={panel.src}
          data-min-width={panel.minWidth}
          data-delay={panel.delay}
          class:list={[
            'size-full object-cover',
            panel.minWidth === 768 && 'hidden md:block',
            panel.minWidth === 1024 && 'hidden lg:block',
          ]}
          poster={panel.poster}
          muted
          loop
          playsinline
          preload="none"
          aria-label={panel.label}
        />
      ))
    }
  </div>

  <!-- A panel only gets a source once its breakpoint is actually met, so a
       phone downloads one clip instead of three. Reduced-motion visitors keep
       the posters and download nothing at all. -->
  <script is:inline>
    (function () {
      var panels = document.querySelectorAll('[data-hero-video]');
      if (!panels.length) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      Array.prototype.forEach.call(panels, function (v) {
        var min = Number(v.dataset.minWidth || 0);
        if (min && !window.matchMedia('(min-width: ' + min + 'px)').matches) return;

        var s = document.createElement('source');
        s.src = v.dataset.src;
        s.type = 'video/mp4';
        v.appendChild(s);

        // Staggered so the three panels never cut in unison.
        v.addEventListener(
          'loadedmetadata',
          function () {
            var d = Number(v.dataset.delay || 0);
            if (d && d < v.duration) v.currentTime = d;
          },
          { once: true },
        );

        v.preload = 'auto';
        v.load();
        // Autoplay can still be refused (low power mode); the poster stays put.
        var play = v.play();
        if (play) play.catch(function () {});
      });
    })();
  </script>

  <!-- Grade: darkened from the bottom for the copy, with a navy wash that ties
       the footage to the crest palette. -->
  <div
    data-hero-veil
    class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,var(--color-ink-950)_2%,rgba(5,7,13,0.82)_28%,rgba(5,7,13,0.45)_58%,rgba(11,27,58,0.5)_100%)]"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(120%_80%_at_50%_50%,transparent_35%,rgba(5,7,13,0.7)_100%)]"
    aria-hidden="true"
  >
  </div>

  <div class="shell flex flex-1 flex-col justify-end pt-32 pb-14 lg:pb-20">
    <div>
      <p class="eyebrow mb-6 flex items-center gap-3 text-bone/70" data-reveal="fade">
        <span class="inline-block h-px w-10 bg-brand-red"></span>
        {site.city}
      </p>

      <!-- Full shell width on purpose. "evolucionar" is eleven characters set at
           `wdth` 112, which runs wider than a 56rem column at these sizes — and
           SplitText's line mask clips the overflow instead of letting it spill,
           so the word lost its tail. The measure below is constrained per block
           rather than by a wrapper around the headline. -->
      <h1 class="display text-[clamp(2.9rem,9.4vw,8.5rem)] text-bone" data-split>
        Más que<br />
        entrenar,<br />
        <span class="text-brand-red">evolucionar</span>
      </h1>

      <p
        class="mt-8 max-w-xl text-lg leading-relaxed text-bone/75"
        data-reveal
        data-reveal-delay="0.15"
      >
        Entrenamos deportistas de forma integral: capacidades físicas, técnica, preparación
        mental y prevención. Cada proceso se diseña sobre una valoración, no sobre una
        rutina genérica.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal data-reveal-delay="0.25">
        <a
          href={whatsappLink(
            'Hola, quiero agendar mi valoración inicial gratuita con Andrés Lara Entrenamientos.',
          )}
          target="_blank"
          rel="noopener"
          class="group relative overflow-hidden rounded-full bg-brand-red px-8 py-4 text-sm font-medium tracking-wide text-bone uppercase"
        >
          <span
            class="absolute inset-0 translate-y-full bg-bone transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-y-0"
          ></span>
          <span class="relative transition-colors duration-300 group-hover:text-ink-950">
            {site.cta}
          </span>
        </a>

        <a
          href="#planes"
          class="group flex items-center gap-2 rounded-full border hairline bg-ink-950/30 px-8 py-4 text-sm tracking-wide text-bone uppercase backdrop-blur-sm transition-colors duration-300 hover:border-bone"
        >
          Ver planes
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            aria-hidden="true"
            class="transition-transform duration-300 group-hover:translate-x-1"
          >
            <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </a>

        <p class="flex items-center gap-2 text-sm text-bone/70">
          <span class="relative flex size-2">
            <span
              class="absolute inline-flex size-full animate-ping rounded-full bg-brand-gold opacity-70"
            ></span>
            <span class="relative inline-flex size-2 rounded-full bg-brand-gold"></span>
          </span>
          Valoración inicial gratuita
        </p>
      </div>
    </div>

    <!-- Stacks below lg. Previously this was one flex row and the stat list
         carried `flex-1`, so its basis was 0 and it collapsed to whatever the
         crest block left over — on a phone that was ~120px for three columns,
         and the labels overlapped each other into noise. -->
    <div
      class="mt-14 flex flex-col gap-8 border-t hairline pt-8 lg:flex-row lg:flex-wrap lg:items-end lg:justify-between"
    >
      <dl class="grid w-full max-w-lg grid-cols-3 gap-4 sm:gap-6 lg:flex-1">
        {
          stats.map((stat, index) => (
            <div data-reveal data-reveal-delay={0.3 + index * 0.08}>
              <dt class="sr-only">{stat.label}</dt>
              <dd>
                <span class="display-tight block text-4xl text-bone lg:text-5xl">
                  <span data-count={stat.value}>0</span>
                  {stat.suffix}
                </span>
                <span
                  class="mt-2 block text-[0.65rem] tracking-wide text-muted uppercase sm:text-xs"
                >
                  {stat.label}
                </span>
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="flex items-center gap-4" data-reveal data-reveal-delay="0.4">
        <Image
          src={brand.crest.src}
          alt={brand.crest.alt}
          widths={[72, 144]}
          sizes="72px"
          loading="eager"
          class="size-16 shrink-0 object-contain lg:size-[4.5rem]"
        />
        <p class="max-w-[13rem] text-xs leading-relaxed text-muted">
          Entrenamiento, preparación física, fisioterapia y comunicación en un mismo
          proceso.
        </p>
      </div>
    </div>
  </div>

  <div
    class="pointer-events-none absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 lg:flex"
    aria-hidden="true"
  >
    <span class="eyebrow text-[0.6rem]">Scroll</span>
    <span class="scroll-line block h-12 w-px bg-bone/25"></span>
  </div>
</section>

<style>
  .scroll-line {
    position: relative;
    overflow: hidden;
  }
  .scroll-line::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 40%;
    background: var(--color-brand-red);
    animation: scroll-cue 2.2s var(--ease-in-out-quart) infinite;
  }
  @keyframes scroll-cue {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(250%);
    }
  }
</style>

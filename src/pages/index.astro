---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Manifesto from '../components/Manifesto.astro';
import Services from '../components/Services.astro';
import Method from '../components/Method.astro';
import Plans from '../components/Plans.astro';
import Kit from '../components/Kit.astro';
import Team from '../components/Team.astro';
import Sponsors from '../components/Sponsors.astro';
import Gallery from '../components/Gallery.astro';
import Reels from '../components/Reels.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
---

<Layout>
  <Hero />
  <Marquee
    items={['Velocidad', 'Fuerza', 'Resistencia', 'Coordinación', 'Agilidad', 'Potencia']}
    speed={34}
  />
  <Manifesto />
  <Services />
  <Method />
  <Marquee
    items={[site.tagline, site.name, site.tagline, site.name]}
    speed={40}
    direction="right"
    tone="solid"
  />
  <Plans />
  <Kit />
  <Team />
  <Sponsors />
  <Gallery />
  <Reels />
  <Faq />
  <CtaBand />
</Layout>

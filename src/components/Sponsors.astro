---
import { Image } from 'astro:assets';
import { sponsors } from '../data/sponsors';

/* The client asked for this wording over "Patrocinadores": these are brands
   that back the project, and the section should give them visibility without
   competing with the main mark. Hence the muted treatment. */

/* The grid draws its hairlines by showing a 1px background through the gaps,
   which means an unfinished last row shows that background as a pale block
   instead of a rule — and the count only divides evenly by luck. Two columns
   below sm and three above need different numbers of blanks, so each
   breakpoint gets its own set and hides the other's. Nothing to do when the
   count already divides: the expression is 0 and no cell is rendered. */
const blanksBase = (2 - (sponsors.length % 2)) % 2;
const blanksSm = (3 - (sponsors.length % 3)) % 3;
---

<section id="marcas" class="relative py-24 lg:py-32">
  <div class="shell">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow mb-5" data-reveal="fade">06 — Respaldo</p>
        <h2 class="display text-[clamp(2rem,4.5vw,3.6rem)] text-bone" data-split>
          Marcas que<br />confían en<br />nosotros
        </h2>
        <p class="mt-7 max-w-sm text-sm leading-relaxed text-muted" data-reveal>
          Empresas y profesionales que creen en el proyecto, respaldan el trabajo y hacen
          parte del crecimiento. Todas van en la indumentaria 2026.
        </p>

        <a
          href="#indumentaria"
          class="group mt-7 inline-flex items-center gap-2 text-sm text-bone transition-colors duration-300 hover:text-brand-red"
          data-reveal
          data-reveal-delay="0.1"
        >
          Ver la indumentaria
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            aria-hidden="true"
            class="transition-transform duration-300 group-hover:translate-x-1"
          >
            <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </a>
      </div>

      <!-- One cell per brand. Brands with a logo file show it; the rest render
           as wordmarks, which keeps the grid even instead of leaving holes. -->
      <ul class="grid grid-cols-2 gap-px self-start overflow-hidden rounded-2xl border hairline bg-[var(--edge)] sm:grid-cols-3 lg:col-span-7">
        {
          sponsors.map((sponsor, index) => (
            <li
              data-reveal
              data-reveal-delay={index * 0.04}
              class="group flex min-h-[8.5rem] flex-col items-center justify-center gap-2 bg-ink-950 px-5 py-8 text-center transition-colors duration-500 hover:bg-ink-900"
            >
              {sponsor.logo ? (
                /* Each mark shows on the background its own file carries. The
                   section used to plate the white ones and screen the black
                   ones out; both treatments read as something the site had
                   added, so neither survives. */
                <Image
                  src={sponsor.logo}
                  alt={sponsor.name}
                  widths={[120, 240, 360]}
                  sizes="120px"
                  loading="lazy"
                  class="h-14 w-auto rounded-md object-contain opacity-60 grayscale transition-all duration-500 group-hover:opacity-100 group-hover:grayscale-0"
                />
              ) : (
                <span class="display-tight text-base leading-tight text-bone/70 transition-colors duration-500 group-hover:text-bone">
                  {sponsor.name}
                </span>
              )}
              {/* Only under a wordmark. Every logo file already sets the
                  descriptor in its own artwork, so repeating it below the
                  image just prints the word twice. */}
              {sponsor.note && !sponsor.logo && (
                <span class="text-[0.68rem] leading-tight text-muted">{sponsor.note}</span>
              )}
            </li>
          ))
        }

        {Array.from({ length: blanksBase }).map(() => (
          <li aria-hidden="true" class="min-h-[8.5rem] bg-ink-950 sm:hidden" />
        ))}
        {Array.from({ length: blanksSm }).map(() => (
          <li aria-hidden="true" class="hidden min-h-[8.5rem] bg-ink-950 sm:block" />
        ))}
      </ul>
    </div>
  </div>
</section>

---
import { Image } from 'astro:assets';
import { serviceGroups, audience } from '../data/services';
import { photos } from '../data/media';

/* One photo per intent: the field session, the professional setting, and the
   physio who runs the health side. The physio file is already cropped to this
   card's framing, so all three sit on the same centred `object-cover`. */
const groupPhoto = [photos.coachGuiding, photos.stadiumWarmup, photos.physioPortrait];
---

<section id="servicios" class="relative py-24 lg:py-40">
  <div class="shell">
    <div class="mb-14 flex flex-wrap items-end justify-between gap-8">
      <div>
        <p class="eyebrow mb-5" data-reveal="fade">02 — Servicios</p>
        <h2 class="display text-[clamp(2.4rem,6vw,5.5rem)] text-bone" data-split>
          Todo lo que<br />necesita el proceso
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-muted" data-reveal>
        Entrenamiento, preparación física y fisioterapia bajo un mismo plan. No hay que
        coordinar tres profesionales por separado.
      </p>
    </div>

    <div class="grid gap-5 lg:grid-cols-3">
      {
        serviceGroups.map((group, index) => (
          <article
            data-reveal
            data-reveal-delay={index * 0.1}
            class="group relative flex flex-col overflow-hidden rounded-[1.5rem] border hairline bg-ink-900/50 transition-colors duration-500 hover:border-bone/25"
          >
            <div class="grain relative overflow-hidden">
              <Image
                src={groupPhoto[index].src}
                alt={groupPhoto[index].alt}
                widths={[420, 640, 900, 1200]}
                sizes="(min-width: 1024px) 30vw, 92vw"
                loading="lazy"
                layout="none"
                class="photo aspect-[16/10] w-full object-cover transition-transform duration-[900ms] ease-[var(--ease-out-expo)] group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/40 to-transparent" />
              <h3 class="display-tight absolute bottom-5 left-6 text-2xl text-bone">
                {group.title}
              </h3>
            </div>

            <ul class="flex-1 space-y-3.5 p-7">
              {group.items.map((item) => (
                <li class="flex gap-3 text-sm leading-relaxed text-bone/85">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 14 14"
                    fill="none"
                    aria-hidden="true"
                    class="mt-1 shrink-0 text-brand-red"
                  >
                    <path d="M1 7.5l4 4L13 2" stroke="currentColor" stroke-width="1.8" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <!-- Audience. Deliberately a plain list of chips: the client's answer is a
         long "everyone from kids to clubs", and chips read faster than prose. -->
    <div class="mt-16 border-t hairline pt-10">
      <p class="eyebrow mb-6" data-reveal="fade">Para quién</p>
      <ul class="flex flex-wrap gap-2.5">
        {
          audience.map((item, index) => (
            <li
              data-reveal
              data-reveal-delay={index * 0.04}
              class="rounded-full border hairline px-5 py-2.5 text-sm text-bone/85"
            >
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

---
import '../styles/global.css';
import { site } from '../data/site';
import { plans } from '../data/plans';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
/* A dedicated 1200x628 crop rather than a hero frame: the hero is vertical
   footage now, and WhatsApp — where most of this link gets shared — crops a
   share card to roughly 1.91:1 and would have cut the subject out. */
const ogImage = new URL('/og.jpg', Astro.site ?? Astro.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  name: site.name,
  description: site.description,
  url: canonical.href,
  telephone: site.phone,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Barranquilla',
    addressCountry: 'CO',
  },
  areaServed: 'Barranquilla, Colombia',
  slogan: site.tagline,
  sameAs: Object.values(site.social),
  makesOffer: plans.map((plan) => ({
    '@type': 'Offer',
    name: plan.name,
    description: plan.summary,
    price: plan.price,
    priceCurrency: plan.currency,
    availability: 'https://schema.org/InStock',
  })),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070d" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!-- The hero is the largest paint on the page. Only the first panel is
         guaranteed to be on screen, so only its poster is worth preloading —
         the other two are behind breakpoints and would be wasted bytes on a
         phone. -->
    <link rel="preload" as="image" href="/posters/hero-night-arrival.jpg" />

    <!-- Everything carrying data-reveal or data-split starts at opacity 0 and
         waits for motion.ts to bring it in. motion.ts stamps data-motion on
         <html> the moment its bundle executes; if that never happens — a chunk
         that fails to download, a browser that refuses the module — the text
         stays invisible with nothing left to reveal it. This is the floor under
         that: no bundle within two seconds and the page shows itself. -->
    <script is:inline>
      setTimeout(function () {
        if (!document.documentElement.hasAttribute('data-motion')) {
          document.documentElement.classList.add('no-motion');
        }
      }, 2000);
    </script>

    <!-- The guard above still needs JavaScript to run. With it off entirely
         nothing ever clears the opacity, so the stylesheet has to. -->
    <noscript>
      <!-- is:inline keeps Astro from lifting this into the CSS bundle, where it
           would apply to everyone and disable the reveals outright. -->
      <style is:inline>
        /* :root only to outrank the opacity: 0 in global.css — Astro injects the
           stylesheet link after this block, so matching its specificity would
           lose on document order. */
        :root [data-reveal],
        :root [data-split] {
          opacity: 1;
        }
      </style>
    </noscript>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[999] focus:rounded-full focus:bg-bone focus:px-5 focus:py-2 focus:text-sm focus:font-medium focus:text-ink-950"
    >
      Saltar al contenido
    </a>

    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <script>
      import '../lib/motion';
    </script>
  </body>
</html>

---
import { Image } from 'astro:assets';
import { photos } from '../data/media';
import { site, whatsappLink } from '../data/site';
---

<section class="relative isolate grain overflow-hidden py-28 lg:py-40">
  <div class="absolute inset-0 -z-20">
    <Image
      src={photos.coachSprint.src}
      alt=""
      aria-hidden="true"
      widths={[720, 960]}
      sizes="100vw"
      loading="lazy"
      data-parallax="10"
      class="size-full scale-110 object-cover object-center will-change-transform"
    />
  </div>
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgba(5,7,13,0.95),rgba(5,7,13,0.7)),radial-gradient(80%_60%_at_80%_50%,rgba(200,16,46,0.3),transparent)]"
  >
  </div>

  <div class="shell max-w-4xl">
    <p class="eyebrow mb-6" data-reveal="fade">{site.motto}</p>

    <!-- Fit-capped at both ends, like the hero headline: "valoración" is one
         unbreakable word 7.43em wide, and this shell is the narrow max-w-4xl
         one. 11.6vw catches the bottom, where the 2.6rem floor was more than a
         320px phone holds; 6.3rem catches the top, where the shell stops at
         56rem and 6.5rem no longer fits inside it. In between the 7vw ramp is
         the smallest of the three and nothing changes. -->
    <h2 class="display text-[min(11.6vw,clamp(2.6rem,7vw,6.3rem))] text-bone" data-split>
      Agenda tu<br />valoración
    </h2>

    <p class="mt-8 max-w-lg text-lg leading-relaxed text-bone/80" data-reveal>
      La valoración inicial es gratuita. Nos permite conocerte, identificar tus
      necesidades y definir los objetivos del proceso — y de ahí sale el plan que
      realmente te sirve.
    </p>

    <div class="mt-10 flex flex-wrap gap-4" data-reveal data-reveal-delay="0.12">
      <a
        href={whatsappLink('Hola, quiero agendar mi valoración inicial gratuita.')}
        target="_blank"
        rel="noopener"
        class="group relative overflow-hidden rounded-full bg-bone px-8 py-4 text-sm font-medium tracking-wide text-ink-950 uppercase"
      >
        <span
          class="absolute inset-0 translate-y-full bg-brand-red transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-y-0"
        ></span>
        <span class="relative transition-colors duration-300 group-hover:text-bone">
          Escribir por WhatsApp
        </span>
      </a>

      <a
        href={`mailto:${site.email}`}
        class="rounded-full border border-bone/25 px-8 py-4 text-sm tracking-wide text-bone uppercase transition-colors duration-300 hover:border-bone"
      >
        {site.email}
      </a>
    </div>

    <p class="mt-8 text-sm text-muted" data-reveal data-reveal-delay="0.2">
      {site.coverage}
    </p>
  </div>
</section>

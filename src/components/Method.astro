---
import { Image } from 'astro:assets';
import { photos } from '../data/media';

const steps = [
  {
    n: '01',
    title: 'Valoración',
    body: 'Medimos fuerza, velocidad, movilidad y tu historial de lesiones. Sin esto, cualquier plan es una apuesta.',
    photo: photos.staffLocker,
  },
  {
    n: '02',
    title: 'Planificación',
    body: 'Diseño tu semana alrededor del calendario real: partidos, viajes, estudio o trabajo.',
    photo: photos.coachBoard,
  },
  {
    n: '03',
    title: 'Ejecución',
    body: 'Cada sesión llega con video, series, cargas y tiempos. Ejecutas, registras, avanzas.',
    photo: photos.coachSprint,
  },
  {
    n: '04',
    title: 'Control de carga',
    body: 'Ajustamos según cómo respondes. Si el cuerpo pide freno, el plan frena.',
    photo: photos.teamTalk,
  },
  {
    n: '05',
    title: 'Reevaluación',
    body: 'Cada cuatro semanas repetimos los test. Comparamos números, no sensaciones.',
    photo: photos.stands,
  },
];
---

<section id="metodo" data-rail class="relative overflow-hidden bg-ink-900 py-24 lg:min-h-screen lg:py-0">
  <div class="lg:flex lg:h-screen lg:flex-col lg:justify-center">
    <div class="shell mb-12 flex flex-wrap items-end justify-between gap-6 lg:mb-14">
      <div>
        <p class="eyebrow mb-5" data-reveal="fade">02 — Método</p>
        <h2 class="display text-[clamp(2.4rem,6vw,5.5rem)] text-bone" data-split>
          Cinco pasos,<br />cero adivinanzas
        </h2>
      </div>
      <p class="max-w-xs text-sm leading-relaxed text-muted" data-reveal>
        El mismo proceso que uso con el plantel profesional, adaptado a tu nivel y a tus
        horarios.
      </p>
    </div>

    <!-- Desktop pins this track and scrubs it sideways; below 1024px it is a
         normal horizontal scroller so touch behaves natively. -->
    <div
      data-rail-track
      class="flex snap-x snap-mandatory gap-5 overflow-x-auto px-[var(--gutter)] pb-6 lg:snap-none lg:overflow-visible lg:pb-0 lg:will-change-transform"
    >
      {
        steps.map((step) => (
          <article class="group w-[78vw] shrink-0 snap-start sm:w-[58vw] md:w-[42vw] lg:w-[26rem]">
            <div class="grain relative overflow-hidden rounded-2xl border hairline">
              <Image
                src={step.photo.src}
                alt={step.photo.alt}
                widths={[420, 640, 860]}
                sizes="(min-width: 1024px) 26rem, 78vw"
                loading="lazy"
                class="photo aspect-[4/5] w-full object-cover transition-transform duration-[900ms] ease-[var(--ease-out-expo)] group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/25 to-transparent" />
              <span class="display absolute top-5 left-6 text-5xl text-bone/25">{step.n}</span>
              <div class="absolute inset-x-6 bottom-6">
                <h3 class="display-tight text-2xl text-bone">{step.title}</h3>
                <p class="mt-2.5 text-sm leading-relaxed text-muted">{step.body}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

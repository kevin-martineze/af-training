---
import { Image } from 'astro:assets';
import { nav, site } from '../data/site';
import { brand } from '../data/media';

const year = new Date().getFullYear();
---

<footer class="border-t hairline bg-ink-950 pt-16 pb-10">
  <div class="shell">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3">
          <Image
            src={brand.crest.src}
            alt={brand.crest.alt}
            widths={[56, 112]}
            sizes="56px"
            loading="lazy"
            class="size-14 shrink-0 object-contain"
          />
          <span class="display-tight text-base leading-[1.15] text-bone">
            Andrés Lara<br /><span class="text-muted">Entrenamientos</span>
          </span>
        </div>
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-muted">{site.description}</p>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">{site.coverage}</p>
      </div>

      <nav aria-label="Pie de página" class="lg:col-span-3">
        <p class="eyebrow mb-5">Navegación</p>
        <ul class="space-y-3">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-bone/80 transition-colors duration-300 hover:text-brand-red"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-4">
        <p class="eyebrow mb-5">Contacto</p>
        <ul class="space-y-3 text-sm text-bone/80">
          <li>
            <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="hover:text-brand-red">
              {site.phone}
            </a>
          </li>
          <li><a href={`mailto:${site.email}`} class="hover:text-brand-red">{site.email}</a></li>
          <li class="text-muted">{site.city}</li>
        </ul>

        <ul class="mt-6 space-y-3">
          <li>
            <a
              href={site.social.instagram}
              target="_blank"
              rel="noopener"
              class="text-sm text-bone/80 hover:text-brand-red"
            >
              Instagram <span class="text-muted">{site.handles.instagram}</span>
            </a>
          </li>
          <li>
            <a
              href={site.social.tiktok}
              target="_blank"
              rel="noopener"
              class="text-sm text-bone/80 hover:text-brand-red"
            >
              TikTok <span class="text-muted">{site.handles.tiktok}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t hairline pt-6 text-xs text-muted"
    >
      <p>© {year} {site.name}. Todos los derechos reservados.</p>
      <p>{site.tagline}</p>
    </div>
  </div>
</footer>

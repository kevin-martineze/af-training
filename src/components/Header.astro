---
import { Image } from 'astro:assets';
import { nav, site, whatsappLink } from '../data/site';
import { brand } from '../data/media';
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,backdrop-filter,border-color] duration-500"
>
  <div class="shell flex items-center justify-between gap-6 py-5">
    <a href="#" class="group flex items-center gap-3" aria-label={`${site.name} — inicio`}>
      <Image
        src={brand.crest.src}
        alt={brand.crest.alt}
        widths={[48, 96]}
        sizes="48px"
        loading="eager"
        class="size-12 shrink-0 object-contain"
      />
      <span class="display-tight text-sm leading-[1.15] tracking-[0.14em] text-bone">
        Andrés Lara<br /><span class="text-muted">Entrenamientos</span>
      </span>
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-8 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="relative text-sm text-muted transition-colors duration-300 hover:text-bone after:absolute after:-bottom-1.5 after:left-0 after:h-px after:w-0 after:bg-brand-red after:transition-[width] after:duration-500 hover:after:w-full"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={whatsappLink('Hola, quiero agendar mi valoración inicial gratuita.')}
        target="_blank"
        rel="noopener"
        class="group relative hidden overflow-hidden rounded-full bg-bone px-5 py-2.5 text-sm font-medium text-ink-950 sm:block"
      >
        <span
          class="absolute inset-0 -translate-y-full bg-brand-red transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-y-0"
        ></span>
        <span class="relative transition-colors duration-300 group-hover:text-bone">
          {site.cta}
        </span>
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="menu-movil"
        class="flex size-11 items-center justify-center rounded-full border hairline lg:hidden"
      >
        <span class="sr-only">Abrir menú</span>
        <span class="relative block h-[11px] w-[18px]" aria-hidden="true">
          <span data-bar class="absolute inset-x-0 top-0 h-px bg-current"></span>
          <span data-bar class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-current"></span>
          <span data-bar class="absolute inset-x-0 bottom-0 h-px bg-current"></span>
        </span>
      </button>
    </div>
  </div>

</header>

<!-- Drawer. Deliberately a sibling of <header> and not a child of it: the
     header takes a `backdrop-filter` once it sticks, and a filtered ancestor
     becomes the containing block for `position: fixed` descendants. Nested,
     the panel resolved `inset-y-0` against the header box and collapsed to
     its height as soon as the page was scrolled.

     `inert` while closed keeps the links out of the tab order without needing
     `hidden`, which would remove the box and leave nothing to slide. -->
<div data-menu-backdrop class="fixed inset-0 z-[55] bg-ink-950/80 backdrop-blur-sm lg:hidden"></div>

<aside
  id="menu-movil"
  data-menu-panel
  inert
  aria-label="Menú"
  class="fixed inset-y-0 right-0 z-[60] flex w-[min(86vw,21rem)] flex-col border-l hairline bg-ink-900 lg:hidden"
>
  <div class="flex items-center justify-between border-b hairline px-6 py-5">
    <span class="eyebrow">Menú</span>
    <button
      type="button"
      data-menu-close
      class="flex size-10 items-center justify-center rounded-full border hairline text-bone transition-colors duration-300 hover:border-bone"
    >
      <span class="sr-only">Cerrar menú</span>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </button>
  </div>

  <nav aria-label="Menú móvil" class="flex flex-1 flex-col overflow-y-auto px-6 py-2">
    {
      nav.map((item, index) => (
        <a
          href={item.href}
          data-menu-link
          style={`--i:${index}`}
          class="group flex items-center justify-between border-b hairline py-5 text-lg text-bone last:border-0"
        >
          {item.label}
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            aria-hidden="true"
            class="text-brand-red transition-transform duration-300 group-hover:translate-x-1"
          >
            <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </a>
      ))
    }
  </nav>

  <div class="border-t hairline p-6">
    <a
      href={whatsappLink('Hola, quiero agendar mi valoración inicial gratuita.')}
      target="_blank"
      rel="noopener"
      data-menu-link
      style={`--i:${nav.length}`}
      class="block rounded-full bg-brand-red px-6 py-4 text-center text-sm font-medium tracking-wide text-bone uppercase"
    >
      {site.cta}
    </a>
  </div>
</aside>


<style>
  [data-header].is-stuck {
    background-color: color-mix(in oklab, var(--color-ink-950) 72%, transparent);
    backdrop-filter: blur(18px) saturate(1.2);
    border-bottom: 1px solid var(--edge);
  }

  /* Closed state lives here rather than in the markup so the panel can animate
     both ways. Everything keys off one attribute on <html>. */
  [data-menu-backdrop] {
    opacity: 0;
    pointer-events: none;
    transition: opacity 500ms var(--ease-out-expo);
  }
  [data-menu-panel] {
    transform: translateX(100%);
    transition: transform 550ms var(--ease-out-expo);
  }
  [data-menu-link] {
    opacity: 0;
    transform: translateX(1.5rem);
    transition:
      opacity 450ms var(--ease-out-expo),
      transform 450ms var(--ease-out-expo);
  }

  html[data-menu-open] [data-menu-backdrop] {
    opacity: 1;
    pointer-events: auto;
  }
  html[data-menu-open] [data-menu-panel] {
    transform: none;
  }
  html[data-menu-open] [data-menu-link] {
    opacity: 1;
    transform: none;
    /* Links arrive after the panel has most of the way in. */
    transition-delay: calc(160ms + var(--i) * 55ms);
  }

  /* Three bars folding into a cross. */
  [data-menu-toggle] [data-bar] {
    transition:
      transform 450ms var(--ease-out-expo),
      opacity 200ms linear;
  }
  [data-menu-toggle][aria-expanded='true'] [data-bar]:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }
  [data-menu-toggle][aria-expanded='true'] [data-bar]:nth-child(2) {
    opacity: 0;
  }
  [data-menu-toggle][aria-expanded='true'] [data-bar]:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-menu-backdrop],
    [data-menu-panel],
    [data-menu-link],
    [data-menu-toggle] [data-bar] {
      transition-duration: 0.01ms;
      transition-delay: 0ms;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const backdrop = document.querySelector<HTMLElement>('[data-menu-backdrop]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const root = document.documentElement;

  if (toggle && panel) {
    const isOpen = () => root.hasAttribute('data-menu-open');

    const setOpen = (open: boolean) => {
      if (open === isOpen()) return;

      root.toggleAttribute('data-menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      // `inert` is what keeps the closed panel out of the tab order; `hidden`
      // would remove it from the box tree and there would be nothing to slide.
      panel.toggleAttribute('inert', !open);

      // Lenis owns the scroll position, so the page keeps moving under an open
      // drawer unless it is told to stop. motion.ts listens for these.
      document.dispatchEvent(new CustomEvent(open ? 'menu:open' : 'menu:close'));

      if (open) {
        panel.querySelector<HTMLAnchorElement>('[data-menu-link]')?.focus();
      } else {
        toggle.focus();
      }
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));
    closeButton?.addEventListener('click', () => setOpen(false));
    backdrop?.addEventListener('click', () => setOpen(false));

    panel.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => setOpen(false)),
    );

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) setOpen(false);
    });

    // Leaving the breakpoint with the drawer open would strand the scroll lock.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Manifesto from '../components/Manifesto.astro';
import Method from '../components/Method.astro';
import Plans from '../components/Plans.astro';
import Coach from '../components/Coach.astro';
import Gallery from '../components/Gallery.astro';
import Reels from '../components/Reels.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
---

<Layout>
  <Hero />
  <Marquee
    items={['Fuerza', 'Velocidad', 'Resistencia', 'Readaptación', 'Táctica', 'Mentalidad']}
    speed={34}
  />
  <Manifesto />
  <Method />
  <Marquee
    items={['Pasión que nos une', 'AF Training', 'Pasión que nos une', 'AF Training']}
    speed={40}
    direction="right"
    tone="solid"
  />
  <Plans />
  <Coach />
  <Gallery />
  <Reels />
  <Faq />
  <CtaBand />
</Layout>

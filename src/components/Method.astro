---
import { Image } from 'astro:assets';
import { photos } from '../data/media';
import { method } from '../data/services';

/* Step copy lives in data/services.ts, transcribed from the client's document.
   The photo pairing is a presentation choice, so it stays here.

   `position` matters on the last one: the huddle shot is a 9:16 phone frame, so
   a centred 4:5 crop pushes the tactical board down behind the caption. Anchored
   to the bottom the board lands mid-card and the parked motorbikes at the top of
   the frame fall away. */
const stepPhoto = [
  { photo: photos.futsalTunnel, position: 'object-center' },
  { photo: photos.teamCircleOverhead, position: 'object-center' },
  { photo: photos.coachSideline, position: 'object-center' },
  { photo: photos.coachBoardPortrait, position: 'object-center' },
  { photo: photos.tacticalHuddle, position: 'object-bottom' },
];
const steps = method.map((step, index) => ({ ...step, ...stepPhoto[index] }));
---

<section id="metodo" data-rail class="relative overflow-hidden bg-ink-900 py-24 lg:min-h-screen lg:py-0">
  <div class="lg:flex lg:h-screen lg:flex-col lg:justify-center">
    <div class="shell mb-12 flex flex-wrap items-end justify-between gap-6 lg:mb-14">
      <div>
        <p class="eyebrow mb-5" data-reveal="fade">03 — Método</p>
        <h2 class="display text-[clamp(2.4rem,6vw,5.5rem)] text-bone" data-split>
          Cinco pasos,<br />cero adivinanzas
        </h2>
      </div>
      <p class="max-w-xs text-sm leading-relaxed text-muted" data-reveal>
        Cada deportista tiene un proceso diferente. El método es el mismo; lo que cambia
        es lo que sale de la valoración.
      </p>
    </div>

    <!-- Desktop pins this track and scrubs it sideways; below 1024px it is a
         normal horizontal scroller so touch behaves natively. -->
    <div
      data-rail-track
      class="flex snap-x snap-mandatory gap-5 overflow-x-auto px-[var(--gutter)] pb-6 lg:snap-none lg:overflow-visible lg:pb-0 lg:will-change-transform"
    >
      {
        steps.map((step) => (
          <article class="group w-[78vw] shrink-0 snap-start sm:w-[58vw] md:w-[42vw] lg:w-[26rem]">
            <div class="grain relative overflow-hidden rounded-2xl border hairline">
              <Image
                src={step.photo.src}
                alt={step.photo.alt}
                widths={[420, 640, 860, 1060]}
                sizes="(min-width: 1024px) 26rem, 78vw"
                loading="lazy"
                class:list={[
                  'photo aspect-[4/5] w-full object-cover transition-transform duration-[900ms] ease-[var(--ease-out-expo)] group-hover:scale-105',
                  step.position,
                ]}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/25 to-transparent" />
              <span class="display absolute top-5 left-6 text-5xl text-bone/25">{step.n}</span>
              <div class="absolute inset-x-6 bottom-6">
                <h3 class="display-tight text-2xl text-bone">{step.title}</h3>
                <p class="mt-2.5 text-sm leading-relaxed text-muted">{step.body}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

---
import { Image } from 'astro:assets';
import { photos } from '../data/media';
import { site } from '../data/site';
---

<section id="entrenador" class="relative border-y hairline bg-ink-900 py-24 lg:py-40">
  <div class="shell grid gap-14 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <figure class="grain relative mx-auto max-w-[24rem] overflow-hidden rounded-[1.75rem] border hairline lg:mx-0 lg:max-w-none">
        <Image
          src={photos.coachSeated.src}
          alt={photos.coachSeated.alt}
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 38vw, 88vw"
          loading="lazy"
          class="photo aspect-[3/4] w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink-950/70 to-transparent"></div>
      </figure>

      <div class="mt-5 grid grid-cols-2 gap-4">
        <figure class="grain overflow-hidden rounded-xl border hairline">
          <Image
            src={photos.staffNight.src}
            alt={photos.staffNight.alt}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 18vw, 44vw"
            loading="lazy"
            class="photo aspect-square w-full object-cover"
          />
        </figure>
        <figure class="grain overflow-hidden rounded-xl border hairline">
          <Image
            src={photos.staffStanding.src}
            alt={photos.staffStanding.alt}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 18vw, 44vw"
            loading="lazy"
            class="photo aspect-square w-full object-cover"
          />
        </figure>
      </div>
    </div>

    <div class="lg:col-span-6 lg:col-start-7 lg:self-center">
      <p class="eyebrow mb-6" data-reveal="fade">04 — Quién te entrena</p>
      <h2 class="display text-[clamp(2.2rem,5.5vw,4.5rem)] text-bone" data-split>
        {site.coach.name}
      </h2>
      <p class="mt-5 text-lg text-muted" data-reveal>{site.coach.role}</p>

      <p class="mt-8 max-w-xl leading-relaxed text-bone/80" data-reveal data-reveal-delay="0.1">
        Vengo del banquillo, no de un curso online. Dirijo preparación física en
        competencia real todas las semanas: partidos, viajes, lesiones, jugadoras que
        estudian y entrenan a la vez. Ese contexto es el que traslado a cada plan
        individual.
      </p>

      <ul class="mt-10 space-y-4">
        {
          site.coach.credentials.map((item, index) => (
            <li
              class="flex items-start gap-4 border-t hairline pt-4 text-sm text-bone/85"
              data-reveal
              data-reveal-delay={0.15 + index * 0.07}
            >
              <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-brand-red" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

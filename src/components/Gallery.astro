---
import { Image } from 'astro:assets';
import { photos } from '../data/media';

/**
 * Rows sum to 12 columns so the mosaic never leaves holes, and every tile in a
 * row resolves to the same height: a 3-col tile at 3:4 is exactly as tall as a
 * 6-col tile at 3:2, and a 4-col tile at 3:4 matches an 8-col tile at 3:2. That
 * is what lets studio portraits and squad photos share a row without either
 * being cropped against its grain.
 *
 * Below lg the grid collapses to two columns and every tile takes 3:4, so the
 * landscape frames carry both ratios.
 */
const WIDE = 'aspect-[3/4] lg:aspect-[3/2]';
const TALL = 'aspect-[3/4]';

/* A tile eight columns wide is nearly three times the area of a three-column
   one, so they cannot share a `sizes`/`widths` pair without either starving the
   big tiles or over-fetching for the small ones. Keyed by column count. */
const COLS: Record<number, { span: string; sizes: string; widths: number[] }> = {
  3: { span: 'lg:col-span-3', sizes: '(min-width: 1024px) 24vw, 46vw', widths: [300, 460, 700] },
  4: { span: 'lg:col-span-4', sizes: '(min-width: 1024px) 32vw, 46vw', widths: [360, 560, 900] },
  6: { span: 'lg:col-span-6', sizes: '(min-width: 1024px) 48vw, 46vw', widths: [480, 760, 1200, 1500] },
  8: { span: 'lg:col-span-8', sizes: '(min-width: 1024px) 64vw, 46vw', widths: [640, 1000, 1500, 2000] },
};

const tiles = [
  { photo: photos.studioPointing, ...COLS[3], ratio: TALL, parallax: 10 },
  { photo: photos.squadOrange, ...COLS[6], ratio: WIDE, parallax: 12 },
  { photo: photos.studio13, ...COLS[3], ratio: TALL, parallax: 16 },

  { photo: photos.studio29, ...COLS[3], ratio: TALL, parallax: 14 },
  { photo: photos.squadWomen, ...COLS[6], ratio: WIDE, parallax: 9 },
  { photo: photos.studio7, ...COLS[3], ratio: TALL, parallax: 11 },

  { photo: photos.studio26, ...COLS[4], ratio: TALL, parallax: 13 },
  { photo: photos.squadYouth, ...COLS[8], ratio: WIDE, parallax: 8 },

  { photo: photos.duoMedal, ...COLS[6], ratio: WIDE, parallax: 15 },
  { photo: photos.squadNight, ...COLS[6], ratio: WIDE, parallax: 10 },
];
---

<section id="galeria" class="py-24 lg:py-40">
  <div class="shell">
    <div class="mb-14 flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow mb-5" data-reveal="fade">07 — Galería</p>
        <h2 class="display text-[clamp(2.4rem,6vw,5.5rem)] text-bone" data-split>
          La gente<br />detrás del proceso
        </h2>
      </div>
      <p class="max-w-xs text-sm leading-relaxed text-muted" data-reveal>
        Deportistas que hacen parte de los procesos, dentro y fuera de la cancha.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-3 lg:grid-cols-12 lg:gap-4">
      {
        tiles.map((tile, index) => (
          <figure
            class:list={['grain group relative overflow-hidden rounded-xl border hairline', tile.span]}
            data-reveal="scale"
            data-reveal-delay={(index % 3) * 0.06}
          >
            <div class:list={['overflow-hidden', tile.ratio]}>
              <Image
                src={tile.photo.src}
                alt={tile.photo.alt}
                widths={tile.widths}
                sizes={tile.sizes}
                loading="lazy"
                data-parallax={tile.parallax}
                class="photo size-full scale-[1.18] object-cover transition-[filter] duration-700 will-change-transform group-hover:brightness-110"
              />
            </div>
            <div class="pointer-events-none absolute inset-0 bg-ink-950/25 transition-opacity duration-700 group-hover:opacity-0" />
          </figure>
        ))
      }
    </div>
  </div>
</section>

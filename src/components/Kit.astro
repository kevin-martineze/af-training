---
import { Image } from 'astro:assets';
import { brand } from '../data/media';
import { currencyFormat, kit } from '../data/plans';
import { whatsappLink } from '../data/site';

/* The kit as a product drop. One stage, five frames, driven by scroll:

     01  the squad — three players in the navy kit, in a wide 16:10 frame
         that morphs into the 2:3 portrait as 02 comes in, so nobody is
         cropped out of the one landscape photo
     02  Andrés Lara in the navy shirt, wiped in from the right
     03  a circle opens on his crest and the camera "lands" on it — the macro
         is shot on the white shirt, which is how the sequence crosses from
         one colourway to the other without a hard cut
     04  an angled wipe turns to the back: the 00 and the sponsor marks, held
         up by a player at the launch
     05  both renders wipe up from below, so the two versions close the run

   The order of 01 and 02 is the client's.

   From lg the whole section pins while the sequence plays. Below lg only the
   stage pins, centred, so a phone sees every frame at full size instead of
   watching the sequence run out while the stage is still sliding in. The
   step list doubles as navigation, and under reduced motion it is the only
   way through: each step fades to its frame.

   Frames 02 to 05 start clipped away in their inline style, so if motion.ts
   never runs the stage still shows a finished photograph — frame 01. */
const steps = [
  { title: 'El equipo', body: 'Jugadoras del proyecto con la azul 2026.' },
  { title: 'En cancha', body: 'Andrés Lara, con el escudo al pecho.' },
  { title: 'El escudo', body: 'Andrés Lara Entrenamientos, en el centro del pecho.' },
  { title: 'La espalda', body: 'El número y las marcas que nos acompañan.' },
  { title: 'Las dos versiones', body: 'Azul y blanca, con la firma de Andrés en la blanca.' },
];
const origin = brand.worn.origin;
---

<section
  id="indumentaria"
  class="relative isolate grain overflow-hidden border-y hairline bg-ink-900"
  data-kit
>
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_70%_at_28%_50%,rgba(200,16,46,0.16),transparent)]"
    aria-hidden="true"
  >
  </div>

  <!-- The year as an outline behind the stage. It drifts sideways on the same
       timeline as the stage, so it keeps moving while the section is pinned —
       a data-parallax here would be measured against the pin and stall. -->
  <p
    class="display pointer-events-none absolute top-1/2 left-0 -z-10 -translate-y-1/2 text-[34vw] leading-none whitespace-nowrap text-transparent select-none [-webkit-text-stroke:1px_rgba(244,242,237,0.07)] lg:text-[22vw]"
    aria-hidden="true"
    data-kit-year
  >
    2026
  </p>

  <div
    class="shell grid items-center gap-12 py-16 lg:min-h-svh lg:grid-cols-12 lg:gap-16 lg:py-10"
  >
    <!-- Stage. Height-led from lg so a pinned section always fits the
         viewport; width-led below that, where nothing pins. -->
    <div class="flex justify-center lg:col-span-6" style="perspective: 1400px" data-kit-pin>
      <div
        class="relative aspect-[2/3] w-full max-w-md [transform-style:preserve-3d] lg:h-[min(82svh,54rem)] lg:w-auto lg:max-w-none"
        data-kit-tilt
      >
        <!-- Centred in the 2:3 box rather than filling it, so motion.ts can
             open it as a wide 16:10 frame for the squad — wider than the box,
             as wide as the column — and morph it into the 2:3 portrait as the
             coach comes in. The box keeps its size throughout, so nothing
             around the stage (or the pin spacer on phones) ever reflows. -->
        <div
          class="absolute top-1/2 left-1/2 size-full -translate-1/2 overflow-hidden rounded-[1.75rem] border hairline bg-ink-950 shadow-[0_40px_120px_-40px_rgba(0,0,0,0.9)]"
          data-kit-stage
          data-kit-origin={origin}
        >
          <!-- The squad, landscape: it gets the wide frame, so a plain cover
               crop keeps all three in the shot. -->
          <div class="absolute inset-0 overflow-hidden" data-kit-layer>
            <Image
              src={brand.squad.src}
              alt={brand.squad.alt}
              widths={[640, 1000, 1400, 2000]}
              sizes="(min-width: 1024px) 44rem, 92vw"
              loading="lazy"
              layout="none"
              class="photo size-full object-cover will-change-transform"
              data-kit-squad
            />
          </div>

          <Image
            src={brand.worn.src}
            alt={brand.worn.alt}
            widths={[420, 640, 900, 1200]}
            sizes="(min-width: 1024px) 36rem, 92vw"
            loading="lazy"
            layout="none"
            class="photo absolute inset-0 size-full object-cover will-change-transform"
            style={`transform-origin: ${origin}; clip-path: inset(0% 0% 0% 100%)`}
            data-kit-layer
          />

          <Image
            src={brand.crestDetail.src}
            alt={brand.crestDetail.alt}
            widths={[420, 640, 900, 1200]}
            sizes="(min-width: 1024px) 36rem, 92vw"
            loading="lazy"
            layout="none"
            class="photo absolute inset-0 size-full object-cover will-change-transform"
            style={`clip-path: circle(0% at ${origin})`}
            data-kit-layer
          />

          <Image
            src={brand.back.src}
            alt={brand.back.alt}
            widths={[420, 640, 900, 1200]}
            sizes="(min-width: 1024px) 36rem, 92vw"
            loading="lazy"
            layout="none"
            class="photo absolute inset-0 size-full object-cover will-change-transform"
            style="clip-path: polygon(0% 0%, 0% 0%, -30% 100%, -30% 100%)"
            data-kit-layer
          />

          <!-- Both renders, stacked. Each row lands near 1.4:1 against renders
               of ~1.2:1, so a cover crop only trims backdrop top and bottom;
               contain left strips of a backdrop colour no CSS value matched. -->
          <div
            class="absolute inset-0 grid grid-rows-2 gap-3 bg-ink-950 p-3"
            style="clip-path: inset(100% 0% 0% 0%)"
            data-kit-layer
          >
            {
              brand.kits.map((colourway) => (
                <figure class="relative overflow-hidden rounded-2xl">
                  <Image
                    src={colourway.src}
                    alt={colourway.alt}
                    widths={[360, 560, 820]}
                    sizes="(min-width: 1024px) 34rem, 88vw"
                    loading="lazy"
                    layout="none"
                    class="size-full object-cover"
                  />
                  <figcaption class="absolute bottom-3 left-4 eyebrow text-[0.6rem] text-bone/85">
                    {colourway.label}
                  </figcaption>
                </figure>
              ))
            }
          </div>

          <!-- Gloss follows the pointer (--mx/--my, set in motion.ts). -->
          <div
            class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 [background:radial-gradient(420px_circle_at_var(--mx,50%)_var(--my,30%),rgba(255,255,255,0.14),transparent_60%)]"
            data-kit-gloss
            aria-hidden="true"
          >
          </div>

          <div
            class="pointer-events-none absolute top-5 left-5 flex items-center gap-2 rounded-full bg-ink-950/70 px-3.5 py-1.5 backdrop-blur-sm"
            aria-hidden="true"
          >
            <span class="eyebrow text-[0.62rem] text-bone" data-kit-counter>01</span>
            <span class="eyebrow text-[0.62rem]">/ 0{steps.length}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="lg:col-span-5 lg:col-start-8">
      <p class="eyebrow mb-5" data-reveal="fade">{kit.name}</p>

      <!-- "VÍSTETE DEL" is 7.18em wide, so the 2.2rem floor still clears a
           320px shell and the ramp clears the 5-of-12 column from lg up.
           The Í is why the mask rule in global.css exists. -->
      <h2 class="display text-[clamp(2.2rem,5vw,4.2rem)] text-bone" data-split>
        Vístete del<br />proceso
      </h2>

      <!-- The steps are buttons: they jump the sequence to their frame. The
           rail on the left fills with the timeline's progress. -->
      <ol class="relative mt-7 space-y-0.5 pl-5" data-reveal data-reveal-delay="0.1">
        <span class="absolute top-0 bottom-0 left-0 w-px bg-bone/12" aria-hidden="true"></span>
        <span
          class="absolute top-0 bottom-0 left-0 w-px origin-top scale-y-0 bg-brand-red"
          aria-hidden="true"
          data-kit-bar
        ></span>
        {
          steps.map((step, index) => (
            <li>
              <button
                type="button"
                class="group/step block w-full py-1.5 text-left opacity-45 transition-opacity duration-500 hover:opacity-80 aria-[current=step]:opacity-100"
                aria-current={index === 0 ? 'step' : undefined}
                data-kit-step={index}
              >
                <span class="flex items-baseline gap-3">
                  <span class="eyebrow text-[0.62rem] text-brand-gold">0{index + 1}</span>
                  <span class="display-tight text-lg text-bone">{step.title}</span>
                </span>
                <span class="mt-1 block pl-8 text-sm leading-relaxed text-muted">{step.body}</span>
              </button>
            </li>
          ))
        }
      </ol>

      <div class="mt-9 flex flex-wrap items-end gap-x-4" data-reveal data-reveal-delay="0.15">
        <p class="display text-[clamp(3rem,7vw,5.5rem)] leading-[0.8] text-bone">
          {currencyFormat(kit.price, kit.currency)}
        </p>
        <span class="eyebrow pb-2 text-brand-gold">{kit.currency}</span>
      </div>

      {/* A chip row rather than a sentence: the entries are proper nouns on
          the kit and joining them into prose put a capital in mid-sentence. */}
      <ul
        class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-bone/85"
        data-reveal
        data-reveal-delay="0.2"
      >
        {kit.includes.map((item, index) => (
          <li class="flex items-center gap-3">
            {index > 0 && <span class="size-1 rounded-full bg-brand-gold" aria-hidden="true" />}
            {item}
          </li>
        ))}
      </ul>

      <a
        href={whatsappLink(
          `Hola, quiero pedir la ${kit.name} (${currencyFormat(kit.price, kit.currency)}). ¿Cómo la consigo?`,
        )}
        target="_blank"
        rel="noopener"
        class="group relative mt-8 inline-flex overflow-hidden rounded-full bg-bone px-8 py-4 text-sm font-medium tracking-wide text-ink-950 uppercase"
        data-reveal
        data-reveal-delay="0.25"
      >
        <span
          class="absolute inset-0 translate-y-full bg-brand-red transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-y-0"
        ></span>
        <span class="relative transition-colors duration-300 group-hover:text-bone">
          Pide la tuya
        </span>
      </a>
    </div>
  </div>
</section>

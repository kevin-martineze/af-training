---
import { reels } from '../data/media';
---

<section class="border-y hairline bg-ink-900 py-20 lg:py-28">
  <div class="shell">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow mb-5" data-reveal="fade">06 — En movimiento</p>
        <h2 class="display-tight text-[clamp(1.9rem,4vw,3.2rem)] text-bone" data-reveal>
          Sesiones reales, sin filtro
        </h2>
      </div>
      <p class="max-w-xs text-sm leading-relaxed text-muted" data-reveal>
        Clips grabados en cancha durante los entrenamientos de la semana.
      </p>
    </div>

    <!-- Native resolution is 464x832, so the rail caps each card at 18rem.
         Playback is gated by IntersectionObserver in motion.ts. -->
    <div class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 lg:gap-6">
      {
        reels.map((reel, index) => (
          <figure
            class="group relative w-[62vw] shrink-0 snap-start sm:w-[40vw] md:w-[16rem] lg:w-[18rem]"
            data-reveal
            data-reveal-delay={index * 0.08}
          >
            <div class="grain relative overflow-hidden rounded-2xl border hairline">
              <video
                data-reel
                src={reel.src}
                poster={reel.poster}
                muted
                loop
                playsinline
                preload="none"
                aria-label={reel.caption}
                class="aspect-[9/16] w-full object-cover"
              />
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-950/85 via-transparent to-transparent" />
              <figcaption class="absolute inset-x-4 bottom-4">
                <p class="display-tight text-sm text-bone">{reel.label}</p>
                <p class="mt-1 text-xs text-muted">{reel.caption}</p>
              </figcaption>
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>
